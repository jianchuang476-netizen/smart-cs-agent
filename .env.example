# Application
APP_ENV=development
APP_DEBUG=true
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: MySQL business data
DATABASE_URL=mysql+asyncmy://smart_cs:smart_cs@localhost:3306/smart_cs
AUTO_CREATE_TABLES=true
AUTO_SEED=false

# LangGraph checkpoints: PostgreSQL
CHECKPOINT_BACKEND=postgres
CHECKPOINT_DATABASE_URL=postgresql://smart_cs:smart_cs@localhost:5432/smart_checkpoints

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Chroma and local BGE models
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=after_sales_policies
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=false
MODEL_CACHE_DIR=./data/models

# OpenAI-compatible LLM. DeepSeek is the default provider.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-new-api-key

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Notifications
NOTIFICATION_PROVIDER=mock
DINGTALK_WEBHOOK=
